{
  "_comment": "Скопируй в pipeline.config.json и заполни под свою машину. КЛЮЧЕЙ ЗДЕСЬ НЕТ И НЕ ДОЛЖНО БЫТЬ — пайплайн строго локальный.",
  "device": "mps",
  "runs_dir": "./runs",
  "assets_dir": "./assets",

  "llm": {
    "provider": "ollama",
    "endpoint": "http://localhost:11434",
    "model": "qwen2.5:32b",
    "format": "json",
    "keep_alive": -1,
    "temperature_by_stage": { "scriptwriter": 0.9, "compliance": 0.2, "visual_director": 0.6, "qa": 0.2 }
  },

  "images": {
    "backend": "comfyui",
    "endpoint": "http://localhost:8188",
    "workflow_json": "./config/comfy_workflow.json",
    "model": "TBD_выбрать_в_задаче_0",
    "candidates": ["z-image-turbo", "flux1-schnell", "qwen-image", "flux1-dev-q8", "sdxl"],
    "resolution": "832x1408",
    "params_note": "steps/CFG/sampler — из docs/IMAGE_PROMPTING.md по выбранной модели",
    "consistency": { "shared_seed": true, "style_lora": null }
  },

  "tts": {
    "backend": "chatterbox",
    "language": "en",
    "voice_reference_wav": null,
    "exaggeration": 0.5,
    "post_atempo": 1.12
  },

  "stt": {
    "backend": "whisper.cpp",
    "binary": "./whisper.cpp/main",
    "model": "./whisper.cpp/models/ggml-large-v3-turbo.bin",
    "word_level": true
  },

  "assembly": {
    "engine": "hyperframes",
    "fallback": "ffmpeg",
    "fps": 30,
    "resolution": "1080x1920",
    "loudnorm": "I=-14:TP=-1:LRA=11",
    "crosspost_variants": 3
  },

  "music": {
    "generate": false,
    "library_dir": "./assets/bgm",
    "manifest": "./assets/bgm/manifest.json"
  },

  "channel": {
    "niche": "TBD_выбрать_в_задаче_0",
    "config_dir": "./config/channel"
  }
}
